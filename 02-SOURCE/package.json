{
  "name": "betwise-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run src/lib/perfMode.test.ts src/perf/hotPaths.test.ts && npm run build && node scripts/check-bundle-budget.mjs",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "npm run test && npm run test:rust && npm run build && node scripts/check-bundle-budget.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:deb": "tauri build --bundles deb",
    "tauri:build:windows": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "tauri:build:windows:x86": "XWIN_ARCH=x86,x86_64 tauri build --runner cargo-xwin --target i686-pc-windows-msvc --bundles nsis",
    "tauri:build:lan:windows": "cp .env.lan .env.production.local && npm run tauri:build:windows",
    "tauri:build:lan:android": "cp .env.lan .env.production.local && npm run tauri -- android build --apk --target aarch64",
    "tauri:build:production": "rm -f .env.production.local && cp .env.production .env && npm run tauri:build",
    "tauri:build:production:windows": "rm -f .env.production.local && cp .env.production .env && npm run tauri:build:windows"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tauri-apps/api": "^2.11.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "laravel-echo": "^2.5.0",
    "lenis": "^1.3.26",
    "pusher-js": "^8.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "swiper": "^14.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "jsdom": "^28.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.12"
  }
}

# Copy to .env.production (and to .env for a production build). Fill real values from the API host.
# API root: include /api, do NOT include the portal slug.
# Staging used for the supplied installer: https://staging.iccpanel.com/api
# Production example: https://iccpanel.com/api
VITE_API_BASE_URL=https://staging.iccpanel.com/api
VITE_PORTAL_SLUG=betwise
VITE_HW_SIMULATOR=false
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap2
VITE_PERF_MODE=auto
